{
  "$defs": {
    "ProtocolVersion": {
      "additionalProperties": false,
      "description": "One negotiated protocol version.",
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Inclusive range of protocol versions supported by one endpoint.",
  "properties": {
    "maximum": {
      "$ref": "#/$defs/ProtocolVersion"
    },
    "minimum": {
      "$ref": "#/$defs/ProtocolVersion"
    }
  },
  "required": [
    "minimum",
    "maximum"
  ],
  "title": "ProtocolVersionRange",
  "type": "object"
}
