{
  "$defs": {
    "CompatibilityAnalysisDigest": {
      "$ref": "#/$defs/Sha256Digest",
      "description": "Complete compatibility-analysis identity."
    },
    "HeartbeatPolicy": {
      "additionalProperties": false,
      "description": "Negotiated heartbeat bounds for one session.",
      "properties": {
        "interval_millis": {
          "format": "uint32",
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        },
        "timeout_millis": {
          "format": "uint32",
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "interval_millis",
        "timeout_millis"
      ],
      "type": "object"
    },
    "ProtocolFeatures": {
      "additionalProperties": false,
      "description": "Additive features negotiated for one protocol session.",
      "properties": {
        "calls": {
          "description": "Asynchronous calls and results.",
          "type": "boolean"
        },
        "cancellation": {
          "description": "Idempotent request cancellation.",
          "type": "boolean"
        },
        "credit_streams": {
          "description": "Credit-controlled byte streams.",
          "type": "boolean"
        },
        "events": {
          "description": "Ordered connection events.",
          "type": "boolean"
        },
        "shared_buffers": {
          "description": "Authenticated duplicated shared-buffer handles.",
          "type": "boolean"
        },
        "sync_lane": {
          "description": "Strict single-outstanding-call synchronous lane.",
          "type": "boolean"
        }
      },
      "required": [
        "calls",
        "cancellation",
        "events",
        "credit_streams",
        "sync_lane",
        "shared_buffers"
      ],
      "type": "object"
    },
    "ProtocolLimits": {
      "additionalProperties": false,
      "description": "Negotiated allocation and concurrency limits for one authenticated connection.",
      "properties": {
        "max_frame_bytes": {
          "description": "Maximum encoded payload bytes in one frame.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "max_graph_nodes": {
          "description": "Maximum nodes in one serialized object graph.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "max_inline_buffer_bytes": {
          "description": "Maximum bytes carried inline rather than streamed or shared.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "max_listener_count": {
          "description": "Maximum connection-owned event listeners.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "max_object_depth": {
          "description": "Maximum nested object/array depth.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "max_open_streams": {
          "description": "Maximum concurrently open streams.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "max_pending_requests": {
          "description": "Maximum unresolved request/response operations.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "max_remote_handles": {
          "description": "Maximum live remote handles.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "max_string_bytes": {
          "description": "Maximum UTF-8 bytes in one string.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_frame_bytes",
        "max_graph_nodes",
        "max_object_depth",
        "max_string_bytes",
        "max_inline_buffer_bytes",
        "max_pending_requests",
        "max_remote_handles",
        "max_open_streams",
        "max_listener_count"
      ],
      "type": "object"
    },
    "ProtocolSessionId": {
      "description": "An authenticated protocol-session identity.",
      "format": "uuid",
      "type": "string"
    },
    "ProtocolVersion": {
      "additionalProperties": false,
      "description": "One negotiated protocol version.",
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "Sha256Digest": {
      "description": "A SHA-256 digest serialized as lowercase `sha256:<hex>` text.",
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Host-to-worker successful connection negotiation.",
  "properties": {
    "compatibility": {
      "$ref": "#/$defs/CompatibilityAnalysisDigest"
    },
    "features": {
      "$ref": "#/$defs/ProtocolFeatures"
    },
    "heartbeat": {
      "$ref": "#/$defs/HeartbeatPolicy"
    },
    "limits": {
      "$ref": "#/$defs/ProtocolLimits"
    },
    "session": {
      "$ref": "#/$defs/ProtocolSessionId"
    },
    "version": {
      "$ref": "#/$defs/ProtocolVersion"
    }
  },
  "required": [
    "session",
    "version",
    "limits",
    "compatibility",
    "heartbeat",
    "features"
  ],
  "title": "RuntimeWelcome",
  "type": "object"
}
