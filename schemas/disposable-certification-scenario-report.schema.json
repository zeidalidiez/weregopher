{
  "$defs": {
    "AdapterId": {
      "description": "A durable adapter identifier.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,253}[a-z0-9])?$",
      "type": "string"
    },
    "ApplicationFamilyId": {
      "description": "A durable application-family identifier, such as `openai.chatgpt`.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,253}[a-z0-9])?$",
      "type": "string"
    },
    "DisposableCertificationScenario": {
      "additionalProperties": false,
      "description": "Canonical bounded description of one exact disposable-state diagnostic scenario.\n\nParsing and content addressing do not authenticate these bytes or authorize their launch.",
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/AdapterId"
        },
        "application_family": {
          "$ref": "#/$defs/ApplicationFamilyId"
        },
        "arguments": {
          "items": {
            "$ref": "#/$defs/DisposableScenarioArgument"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "executable": {
          "$ref": "#/$defs/ExecutionPackagePath"
        },
        "execution": {
          "$ref": "#/$defs/DisposableScenarioExecution"
        },
        "format_version": {
          "$ref": "#/$defs/DisposableCertificationScenarioFormatVersion"
        },
        "id": {
          "$ref": "#/$defs/ScenarioId"
        },
        "state_roots": {
          "items": {
            "$ref": "#/$defs/DisposableScenarioStateRoot"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "workflow": {
          "$ref": "#/$defs/FeatureId"
        }
      },
      "required": [
        "format_version",
        "id",
        "application_family",
        "adapter_id",
        "workflow",
        "executable",
        "state_roots",
        "arguments",
        "execution"
      ],
      "type": "object"
    },
    "DisposableCertificationScenarioFormatVersion": {
      "enum": [
        "1"
      ],
      "type": "string"
    },
    "DisposableCertificationScenarioReportFormatVersion": {
      "enum": [
        "1"
      ],
      "type": "string"
    },
    "DisposableScenarioArgument": {
      "description": "One ordered argument in a disposable certification scenario.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "One exact fixed argument.",
          "properties": {
            "kind": {
              "const": "literal",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ExecutionArgument",
              "description": "Exact fixed argument value."
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One argument composed from an exact prefix and a separately supplied state-root path.",
          "properties": {
            "kind": {
              "const": "state_path",
              "type": "string"
            },
            "prefix": {
              "$ref": "#/$defs/ExecutionArgument",
              "description": "Exact argument prefix placed before the absolute state path."
            },
            "state_root": {
              "$ref": "#/$defs/ScenarioStateRootId",
              "description": "Logical disposable-state root."
            }
          },
          "required": [
            "kind",
            "state_root",
            "prefix"
          ],
          "type": "object"
        }
      ]
    },
    "DisposableScenarioExecution": {
      "additionalProperties": false,
      "description": "Fixed process posture and limits for disposable scenario format 1.",
      "properties": {
        "dependency_policy": {
          "$ref": "#/$defs/ExecutionDependencyPolicy"
        },
        "limits": {
          "$ref": "#/$defs/DisposableScenarioLimits"
        },
        "security_posture": {
          "$ref": "#/$defs/EffectiveSecurityPosture"
        },
        "state_mode": {
          "$ref": "#/$defs/ExecutionStateMode"
        }
      },
      "required": [
        "state_mode",
        "security_posture",
        "dependency_policy",
        "limits"
      ],
      "type": "object"
    },
    "DisposableScenarioExecutionObservation": {
      "additionalProperties": false,
      "description": "Deterministic successful process and state observations.",
      "properties": {
        "job_membership": {
          "$ref": "#/$defs/DisposableScenarioPassedCheck"
        },
        "job_tree_termination": {
          "$ref": "#/$defs/DisposableScenarioPassedCheck"
        },
        "primary_process_exit": {
          "$ref": "#/$defs/DisposableScenarioPassedCheck"
        },
        "selected_timeout_millis": {
          "format": "uint64",
          "maximum": 600000,
          "minimum": 1,
          "type": "integer"
        },
        "snapshot_revalidation": {
          "$ref": "#/$defs/DisposableScenarioPassedCheck"
        },
        "success_file": {
          "$ref": "#/$defs/DisposableScenarioSuccessFileObservation"
        }
      },
      "required": [
        "selected_timeout_millis",
        "job_membership",
        "job_tree_termination",
        "primary_process_exit",
        "snapshot_revalidation",
        "success_file"
      ],
      "type": "object"
    },
    "DisposableScenarioLimits": {
      "additionalProperties": false,
      "description": "Exact time, launch, and Job Object limits for one disposable scenario.",
      "properties": {
        "maximum_argument_utf16_units": {
          "format": "uint32",
          "maximum": 32766,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_arguments": {
          "format": "uint32",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "maximum_command_line_utf16_units": {
          "format": "uint32",
          "maximum": 32767,
          "minimum": 2,
          "type": "integer"
        },
        "maximum_timeout_millis": {
          "format": "uint64",
          "maximum": 600000,
          "minimum": 1,
          "type": "integer"
        },
        "poll_interval_millis": {
          "format": "uint64",
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        },
        "resource_limits": {
          "$ref": "#/$defs/ExecutionResourceLimits"
        },
        "shutdown_timeout_millis": {
          "format": "uint64",
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maximum_timeout_millis",
        "poll_interval_millis",
        "shutdown_timeout_millis",
        "maximum_arguments",
        "maximum_argument_utf16_units",
        "maximum_command_line_utf16_units",
        "resource_limits"
      ],
      "type": "object"
    },
    "DisposableScenarioPackageObservation": {
      "additionalProperties": false,
      "description": "Exact retained package facts used by one scenario run.",
      "properties": {
        "executable_sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "package_bytes": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "package_files": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "package_tree_merkle": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "package_tree_merkle",
        "executable_sha256",
        "package_files",
        "package_bytes"
      ],
      "type": "object"
    },
    "DisposableScenarioPassedCheck": {
      "enum": [
        "passed"
      ],
      "type": "string"
    },
    "DisposableScenarioStateRoot": {
      "additionalProperties": false,
      "description": "One logical state root whose absolute path is supplied separately at run time.",
      "properties": {
        "definition": {
          "$ref": "#/$defs/DisposableScenarioStateRootKind"
        },
        "id": {
          "$ref": "#/$defs/ScenarioStateRootId"
        }
      },
      "required": [
        "id",
        "definition"
      ],
      "type": "object"
    },
    "DisposableScenarioStateRootKind": {
      "description": "Preparation and observation semantics for one logical disposable-state root.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The runner creates a new empty directory before process creation.",
          "properties": {
            "kind": {
              "const": "empty_directory",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The process must create one exact bounded success file.",
          "properties": {
            "kind": {
              "const": "success_file",
              "type": "string"
            },
            "maximum_bytes": {
              "description": "Maximum bytes the runner may read from this file.",
              "format": "uint64",
              "maximum": 1048576,
              "minimum": 1,
              "type": "integer"
            },
            "sha256": {
              "$ref": "#/$defs/Sha256Digest",
              "description": "Exact required success-file byte identity."
            },
            "size_bytes": {
              "description": "Exact required success-file byte length.",
              "format": "uint64",
              "maximum": 1048576,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "sha256",
            "size_bytes",
            "maximum_bytes"
          ],
          "type": "object"
        }
      ]
    },
    "DisposableScenarioSuccessFileObservation": {
      "additionalProperties": false,
      "description": "Exact successful file observation from one disposable scenario.",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "size_bytes": {
          "format": "uint64",
          "maximum": 1048576,
          "minimum": 0,
          "type": "integer"
        },
        "state_root": {
          "$ref": "#/$defs/ScenarioStateRootId"
        }
      },
      "required": [
        "state_root",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "EffectiveSecurityPosture": {
      "description": "The enforcement mechanism that actually constrains an executable component.",
      "oneOf": [
        {
          "const": "broker_mediated",
          "description": "Relevant host effects cross an enforcing Weregopher broker.",
          "type": "string"
        },
        {
          "const": "os_contained",
          "description": "Independently tested operating-system controls constrain direct host access.",
          "type": "string"
        },
        {
          "const": "vendor_equivalent_full_trust",
          "description": "The component can exercise the current Windows user's ordinary authority.",
          "type": "string"
        }
      ]
    },
    "ExecutionArgument": {
      "description": "One bounded fixed command-line argument.",
      "maxLength": 8192,
      "pattern": "^[^\\u0000]*$",
      "type": "string",
      "x-weregopher-maxUtf8Bytes": 8192
    },
    "ExecutionDependencyPolicy": {
      "description": "Required loader dependency-namespace behavior for one execution target.",
      "oneOf": [
        {
          "const": "vendor_default_ambient",
          "description": "Permit unsealed ambient Windows loader resolution from the executable directory and system.\n\nThis mode does not claim that package-relative DLLs or resources form a closed immutable set,\nor that a relocated executable preserves its original package-relative dependency behavior.",
          "type": "string"
        },
        {
          "const": "manifest_closed",
          "description": "Require every load-bearing dependency to come from an immutable manifest-closed namespace.",
          "type": "string"
        }
      ]
    },
    "ExecutionPackagePath": {
      "description": "Canonical package-relative Windows path. Rust validation also rejects DOS device aliases in every component.",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[<>:\"\\\\|?*\\u0000-\\u001f])(?!.*[. ](?:/|$)).+$",
      "type": "string",
      "x-weregopher-maxPathComponents": 256,
      "x-weregopher-maxUtf8Bytes": 4096,
      "x-weregopher-windowsDeviceAliasesRejected": true
    },
    "ExecutionResourceLimits": {
      "additionalProperties": false,
      "description": "Nonzero Windows Job limits. Rust validation additionally requires process_memory_limit_bytes <= job_memory_limit_bytes.",
      "properties": {
        "active_process_limit": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "job_memory_limit_bytes": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "process_memory_limit_bytes": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "active_process_limit",
        "process_memory_limit_bytes",
        "job_memory_limit_bytes"
      ],
      "type": "object",
      "x-weregopher-processMemoryAtMostJobMemory": true
    },
    "ExecutionStateMode": {
      "description": "State namespace selected by one exact execution target contract.",
      "oneOf": [
        {
          "const": "disposable",
          "description": "Candidate validation uses isolated disposable state.",
          "type": "string"
        },
        {
          "const": "production",
          "description": "A separately approved production-state policy is required.",
          "type": "string"
        },
        {
          "const": "vendor_default",
          "description": "The target intentionally uses the vendor's ambient process-default state behavior.\n\nThis mode provides no state isolation or retained namespace capability. It exists so the\ninitial full-trust process primitive does not misrepresent ambient state as disposable or\nproduction-state mediation.",
          "type": "string"
        }
      ]
    },
    "FeatureId": {
      "description": "A durable application-workflow or compatibility-feature identifier.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,253}[a-z0-9])?$",
      "type": "string"
    },
    "ScenarioId": {
      "description": "A certification scenario identifier.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,253}[a-z0-9])?$",
      "type": "string"
    },
    "ScenarioStateRootId": {
      "description": "A logical disposable-state root within one certification scenario.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]{0,253}[a-z0-9])?$",
      "type": "string"
    },
    "Sha256Digest": {
      "description": "A SHA-256 digest serialized as lowercase `sha256:<hex>` text.",
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical non-authorizing report from one successful disposable-state scenario.",
  "properties": {
    "execution": {
      "$ref": "#/$defs/DisposableScenarioExecutionObservation"
    },
    "format_version": {
      "$ref": "#/$defs/DisposableCertificationScenarioReportFormatVersion"
    },
    "package": {
      "$ref": "#/$defs/DisposableScenarioPackageObservation"
    },
    "scenario": {
      "$ref": "#/$defs/DisposableCertificationScenario"
    }
  },
  "required": [
    "format_version",
    "scenario",
    "package",
    "execution"
  ],
  "title": "DisposableCertificationScenarioReport",
  "type": "object",
  "x-weregopher-maxDocumentBytes": 131072
}
